# Guava-only Supabase project. A publishable key is safe in a browser; never put a secret/service key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set only for a published build after Google OAuth is ready; local preview can stay open.
VITE_REQUIRE_AUTH=false
# Optional production providers; empty uses the public Photon/OSRM fallbacks.
VITE_GEOCODER_URL=
VITE_ROUTER_URL=
